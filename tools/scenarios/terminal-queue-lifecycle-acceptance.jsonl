{"type":"point!([0.4,0.4,0]); line!([0.2,0.2,0],[0.7,0.2,0]); @assert status().pending_count==1; println(\"queue-\"*\"teardown\")"}
{"key":"enter"}
{"wait_terminal_contains":"queue-teardown","timeout_ms":10000}
