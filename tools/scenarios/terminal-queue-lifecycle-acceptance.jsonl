{"wait_state":"terminal_ready","timeout_ms":10000}
{"do":"pause_animation"}
{"wait_state":"animation_paused","timeout_ms":10000}
{"type":"for i in 1:EuclidRepl.ACTION_QUEUE_CAPACITY; highlight_pen!([0.3,0.4,0],[0.6,0.4,0];duration=0.1); end; @assert status().pending_count==31; rejected=false; try point!([0.5,0.5,0]); catch e; e isa ArgumentError || rethrow(); global rejected=true; end; @assert rejected && status().pending_count==31 && status().managed_shape_count==0; println(\"queue-\"*\"capacity\")"}
{"key":"enter"}
{"wait_terminal_contains":"queue-capacity","timeout_ms":10000}
{"do":"resume_animation"}
{"type":"while !status().drained && !status().failed; sleep(0.01); end; @assert !status().failed && status().completed_count==32; @assert !isdefined(@__MODULE__,:stop!); println(\"queue-\"*\"drained\")"}
{"key":"enter"}
{"wait_terminal_contains":"queue-drained","timeout_ms":20000}
{"allocation_checkpoint":"animation"}
{"allocation_checkpoint":"snapshot_slots"}
{"allocation_checkpoint":"display_cache"}
{"type":"for i in 1:32; highlight_pen!([0.3,0.4,0],[0.6,0.4,0];duration=0.1); end; while !status().drained && !status().failed; sleep(0.01); end; @assert !status().failed && status().completed_count==64; println(\"queue-\"*\"reused\")"}
{"key":"enter"}
{"wait_terminal_contains":"queue-reused","timeout_ms":20000}
