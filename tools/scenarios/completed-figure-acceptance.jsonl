{"wait_state":"runtime_ready","timeout_ms":10000}
{"select_animation":"Proposition I","as":"selection"}
{"wait_event":"animation_selected","correlation":"selection","timeout_ms":10000}
{"do":"pause_construction"}
{"wait_state":"construction_paused","timeout_ms":10000}
{"assert_state":"simulation_running"}
{"emit_dust":{"distribution":"disc","count":200,"x":0.5,"y":0.5,"radius":0.2,"seed":7}}
{"wait_state":"dust_active","timeout_ms":10000}
{"do":"show_completed","as":"completed"}
{"wait_event":"animation_completed","correlation":"completed","timeout_ms":10000}
{"assert_state":"animation_completed"}
{"assert_state":"construction_paused"}
{"assert_state":"simulation_running"}
{"screenshot":".build/completed-figure.png"}
{"wait_event":"capture_completed","timeout_ms":10000}
{"set_setting":{"key":"interface.enable_particle_effects","value":false}}
{"wait_state":"particle_effects_disabled","timeout_ms":10000}
{"wait_state":"presentation_effects_settled","timeout_ms":10000}
{"do":"resume_construction"}
{"wait_event":"animation_reset_committed","timeout_ms":10000}
{"assert_state":"construction_playing"}
{"set_setting":{"key":"animation.open_completed","value":true}}
{"select_animation":"Point","as":"point"}
{"wait_event":"animation_selected","correlation":"point","timeout_ms":10000}
{"wait_state":"animation_completed","timeout_ms":10000}
{"assert_state":"construction_paused"}
{"set_setting":{"key":"animation.open_completed","value":false}}
{"assert_state":"animation_completed"}
{"do":"reset_animation"}
{"wait_event":"animation_reset_committed","timeout_ms":10000}
{"assert_no_bad_frees":true}
{"shutdown":true}
