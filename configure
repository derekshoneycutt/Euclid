#!/bin/sh
# --------- AIRTIGHT POLYGLOT HEADER ---------
# The line below is a command in bash/sh, but evaluated cleanly by PowerShell.
# Linux runs the code inside the brackets and exits immediately.
cat << 'EOF' > /dev/null
<#
EOF

# ==============================================================================
# UNIX / SH EXECUTION BLOCK (Linux, macOS / Darwin)
# ==============================================================================
# This script verifies the required toolchain and installs the project's Julia
# dependencies. It is safe to re-run; existing packages are left alone.
printf "\033[36m--- Configuring Project (Unix / sh) ---\033[0m\n"

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
JULIA_PROJECT="$SCRIPT_DIR/src/julia"

success=0

test_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        printf "\033[31mRequired dependency missing: %s\033[0m\n" "$1" >&2
        return 1
    fi
    printf "\033[32mFound %s at: %s\033[0m\n" "$1" "$(command -v "$1")"
    return 0
}

# Verify the core build tools are on PATH.
test_command "odin" || success=1
test_command "julia" || success=1

if [ "$success" -ne 0 ]; then
    printf "\033[31mConfiguration failed! Please install the missing tools.\033[0m\n" >&2
    exit 1
fi

# Install the application Julia project dependencies (src/julia/Project.toml).
printf "\033[36mInstalling Julia application dependencies...\033[0m\n"
if ! julia --project="$JULIA_PROJECT" -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'; then
    printf "\033[31mFailed to install Julia application dependencies.\033[0m\n" >&2
    exit 1
fi

# Ensure the Julia packages used by the vet/static-analysis tooling are present
# in the default environment (the vet script runs in that environment). The
# check is load-based so already-available (even transitive) packages are skipped.
printf "\033[36mEnsuring Julia static-analysis packages (JET, JuliaSyntax, CodeComplexity)...\033[0m\n"
if ! julia -e 'pkgs = ("JET", "JuliaSyntax", "CodeComplexity"); missing = String[]; for name in pkgs; present = try; Base.eval(Main, Meta.parse("using " * name)); true; catch; false; end; present || push!(missing, name); end; if !isempty(missing); println("Installing: ", join(missing, ", ")); using Pkg; Pkg.add(collect(missing)); else; println("All static-analysis packages already available."); end'; then
    printf "\033[31mFailed to install Julia static-analysis packages.\033[0m\n" >&2
    exit 1
fi

printf "\033[32mConfiguration successful! Toolchain and Julia dependencies are ready.\033[0m\n"

# CRITICAL: This stops the shell from reading anything below this line!
exit 0

# Close the multi-line comment block for Windows PowerShell
#>

# ==============================================================================
# WINDOWS / POWERSHELL EXECUTION BLOCK
# ==============================================================================
# Mirrors the Unix block: verifies the toolchain, then installs the Julia
# dependencies. Safe to re-run; existing packages are left alone.
Write-Host "--- Configuring Project (Windows / PowerShell) ---" -ForegroundColor Cyan

$ScriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path
$JuliaProject = Join-Path $ScriptDir "src\julia"
$success = $true

function Test-Command ($cmd) {
    $path = Get-Command $cmd -ErrorAction SilentlyContinue
    if (-not $path) {
        Write-Host "Required dependency missing: $cmd" -ForegroundColor Red
        return $false
    }
    Write-Host "Found $cmd at: $($path.Source)" -ForegroundColor Green
    return $true
}

# Verify the core build tools and the Windows-specific bridge tools.
if (-not (Test-Command "odin"))  { $success = $false }
if (-not (Test-Command "julia")) { $success = $false }

if (-not $env:VCINSTALLDIR -and -not $env:INCLUDE) {
    Write-Warning "MSVC environment variables not detected. Checking for cl.exe..."
    if (-not (Test-Command "cl")) { $success = $false }
} else {
    Write-Host "MSVC Environment detected via VCINSTALLDIR." -ForegroundColor Green
}

if (-not (Test-Command "gendef")) { $success = $false }

if (-not $success) {
    Write-Host "Configuration failed! Please install the missing tools and add them to your PATH." -ForegroundColor Red
    Exit 1
}

# Install the application Julia project dependencies (src/julia/Project.toml).
Write-Host "Installing Julia application dependencies..." -ForegroundColor Cyan
& julia "--project=$JuliaProject" -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'
if ($LASTEXITCODE -ne 0) {
    Write-Host "Failed to install Julia application dependencies." -ForegroundColor Red
    Exit 1
}

# Ensure the Julia packages used by the vet/static-analysis tooling are present
# in the default environment (the vet script runs in that environment). The
# check is load-based so already-available (even transitive) packages are skipped.
Write-Host "Ensuring Julia static-analysis packages (JET, JuliaSyntax, CodeComplexity)..." -ForegroundColor Cyan
& julia -e 'pkgs = ("JET", "JuliaSyntax", "CodeComplexity"); missing = String[]; for name in pkgs; present = try; Base.eval(Main, Meta.parse("using " * name)); true; catch; false; end; present || push!(missing, name); end; if !isempty(missing); println("Installing: ", join(missing, ", ")); using Pkg; Pkg.add(collect(missing)); else; println("All static-analysis packages already available."); end'
if ($LASTEXITCODE -ne 0) {
    Write-Host "Failed to install Julia static-analysis packages." -ForegroundColor Red
    Exit 1
}

Write-Host "Configuration successful! Toolchain and Julia dependencies are ready." -ForegroundColor Green
Exit 0
